# =====================================================================
# TEMPORARY 302 TEST REDIRECTS - old cstech.ai URLs -> new demo site cst.convomax.online
# Source: CS_Tech_Old_to_New_301_Redirect_Mapping.xlsx, rows "301 Redirect" (74 approved).
# NOT the production 301s. Remove this whole block after testing.
#
# WHERE: the .htaccess in the document root of the CURRENT cstech.ai server (old website, Apache),
#        at the very TOP, above every existing rule (the old site already has its own
#        http->https / www rules). Change nothing else. Keep a backup of that file.
#
# WHO IS REDIRECTED: only browsers that carry the cookie  cst_redirect_test=1
#   switch ON  : open https://cstech.ai/?cst_redirect_test=on    (sets the cookie, 1 day)
#   switch OFF : open https://cstech.ai/?cst_redirect_test=off   (deletes the cookie)
#   Everyone else (public visitors, Googlebot) gets the old website exactly as today.
#
# - 302 (temporary). Old URL with or without trailing slash, any letter case; query strings are kept.
# - Unmapped URLs are not redirected. Responses are marked no-store so no cache keeps the 302.
# =====================================================================
# BEGIN cstech-temporary-302-test
<IfModule mod_rewrite.c>
    RewriteEngine On

    # tester switch (cookie only; no redirect)
    RewriteCond %{QUERY_STRING} (^|&)cst_redirect_test=on(&|$) [NC]
    RewriteRule ^ - [CO=cst_redirect_test:1:.cstech.ai:1440:/:secure:httponly,E=CST_TEST_302:1]
    RewriteCond %{QUERY_STRING} (^|&)cst_redirect_test=off(&|$) [NC]
    RewriteRule ^ - [CO=cst_redirect_test:0:.cstech.ai:-1:/:secure:httponly,E=CST_TEST_302:1]

    RewriteCond %{HTTP_COOKIE} (^|;\s*)cst_redirect_test=1(;|$)
    RewriteRule ^emerging-tech/?$ https://cst.convomax.online/services/emerging-tech.html [R=302,L,NC,E=CST_TEST_302:1]
