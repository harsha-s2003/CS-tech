# =====================================================================================
# CS TECH Ai - https://cstech.ai  (Apache .htaccess for the website root)
#
# What this file does, in order:
#   1. Hides internal folders (tools, git) - they answer 404.
#   2. Old website URLs -> new pages, 301, one hop        (block generated from seo-migration/redirects.csv)
#   3. Safety net: unknown URLs under an old section -> that section's new page (also generated)
#   4. http -> https and www -> cstech.ai
#   5. Clean URLs: "/about.html", "/about/" and "/index.html" -> "/about", "/"; pages are served without ".html"
#   6. Case-studies filter views (/case-studies/Industries/Water-Wastewater)
#   7. Custom 404 page for everything else
#
# To add or change a redirect: edit seo-migration/redirects.csv, then run
#     node seo-migration/build-redirects.js
# It checks the list and rewrites ONLY the two generated blocks below. Do not hand-edit them
# (the next build overwrites them); everything else in this file is safe to edit by hand.
# Full guide: seo-migration/README-REDIRECTS.md
# =====================================================================================

ErrorDocument 404 /404.html

# /news, /blogs and /case-studies are pages AND folders. Without this, Apache would answer
# /news with a redirect to /news/ before the clean-URL rules can serve news.html (a loop).
# Folders without a page answer 404 (section 7), so nothing is ever listed.
# Needs "AllowOverride All" for the site (standard on cPanel hosting).
<IfModule mod_dir.c>
    DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ---- 1. Internal folders: never served -------------------------------------------
    RewriteRule ^(seo-migration|CS-tech_NewPages|\.git|\.claude|\.vscode)(/|$) - [R=404,L,NC]

    # ---- 2. Old website URLs -> new pages (generated - do not edit by hand) -------------
    # BEGIN cstech-301-redirects
    # generated 2026-11-06 from seo-migration/redirects.csv - do not edit by hand
    RewriteCond %{REQUEST_URI} !^/about$
    RewriteRule ^about/?$ https://cstech.ai/about [R=301,L,NC]
    RewriteCond %{REQUEST_URI} !^/careers$
    RewriteRule ^careers/?$ https://cstech.ai/careers [R=301,L,NC]
    RewriteCond %{REQUEST_URI} !^/contact$
    RewriteRule ^contact/?$ https://cstech.ai/contact [R=301,L,NC]
    RewriteRule ^emerging-tech/?$ https://cstech.ai/services/emerging-tech [R=301,L,NC]
    RewriteRule ^geospatial/?$ https://cstech.ai/services/geospatial-services [R=301,L,NC]
    RewriteRule ^geospatial/analytics/?$ https://cstech.ai/services/modelling-analytics [R=301,L,NC]
    RewriteRule ^geospatial/consulting/?$ https://cstech.ai/services/engineering-consulting [R=301,L,NC]
    RewriteRule ^geospatial/data-acquisition/?$ https://cstech.ai/services/data-acquisition [R=301,L,NC]
    RewriteRule ^geospatial/digital-enterprise/?$ https://cstech.ai/services/enterprise-gis-spatial-intelligence [R=301,L,NC]
    RewriteRule ^geospatial/engineering-support/?$ https://cstech.ai/services/bim-3d-modelling-digital-twins [R=301,L,NC]
    RewriteRule ^geospatial/software-solutions/?$ https://cstech.ai/services/solution-development [R=301,L,NC]
    RewriteRule ^geospatial/support-ticket/?$ https://cstech.ai/services/support-ticket [R=301,L,NC]
    RewriteRule ^geospatialamericas/?$ https://cstech.ai/usa [R=301,L,NC]
    RewriteRule ^geospatialamericas/about/?$ https://cstech.ai/usa [R=301,L,NC]
    RewriteRule ^geospatialamericas/contact/?$ https://cstech.ai/contact [R=301,L,NC]
    RewriteRule ^geospatialamericas/industries/public-infrastructure/?$ https://cstech.ai/usa [R=301,L,NC]
    RewriteRule ^geospatialamericas/industries/retail-and-real-estate/?$ https://cstech.ai/usa [R=301,L,NC]
