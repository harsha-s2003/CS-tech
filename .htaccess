    RewriteRule ^resources/news-and-publications/honble-shri-dattaji-meghe-in-grateful-remembrance/?$ https://cstech.ai/news/honble-shri-dattaji-meghe-in-grateful-remembrance [R=301,L,NC]
    RewriteRule ^resources/news-and-publications/how-cs-tech-ai-is-reimagining-indias-tech-footprint-with-a-global-vision/?$ https://cstech.ai/news/how-cs-tech-ai-is-reimagining-indias-tech-footprint-with-a-global-vision [R=301,L,NC]
    RewriteRule ^resources/news-and-publications/transformations-through-innovation-in-aec-technology/?$ https://cstech.ai/news/transformations-through-innovation-in-aec-technology [R=301,L,NC]
    # END cstech-301-redirects

    # ---- 3. Safety net for old URLs that are not in the list (generated - do not edit) --
    # BEGIN cstech-301-safety-net
    # generated 2026-11-06 from seo-migration/redirects.csv - do not edit by hand
    # unknown /resources/blogs/... -> https://cstech.ai/blogs
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} ^(.+?)/*$
    RewriteCond %1.html !-f
    RewriteRule ^resources/blogs/. https://cstech.ai/blogs [R=301,L,NC]
    # unknown /resources/case-studies/... -> https://cstech.ai/case-studies
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} ^(.+?)/*$
    RewriteCond %1.html !-f
    RewriteRule ^resources/case-studies/. https://cstech.ai/case-studies [R=301,L,NC]
    # unknown /resources/news-and-publications/... -> https://cstech.ai/news
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} ^(.+?)/*$
    RewriteCond %1.html !-f
    RewriteRule ^resources/news-and-publications/. https://cstech.ai/news [R=301,L,NC]
    # unknown /geospatial/... -> https://cstech.ai/services/geospatial-services
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} ^(.+?)/*$
    RewriteCond %1.html !-f
    RewriteRule ^geospatial/. https://cstech.ai/services/geospatial-services [R=301,L,NC]
    # unknown /geospatialamericas/... -> https://cstech.ai/usa
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} ^(.+?)/*$
    RewriteCond %1.html !-f
    RewriteRule ^geospatialamericas/. https://cstech.ai/usa [R=301,L,NC]
    # unknown /infra-utilities/... -> https://cstech.ai/services/geospatial-services
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} ^(.+?)/*$
    RewriteCond %1.html !-f
    RewriteRule ^infra-utilities/. https://cstech.ai/services/geospatial-services [R=301,L,NC]
    # unknown /mobility/... -> https://cstech.ai/mobility/automotive
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} ^(.+?)/*$
    RewriteCond %1.html !-f
    RewriteRule ^mobility/. https://cstech.ai/mobility/automotive [R=301,L,NC]
    # unknown /resources/... -> https://cstech.ai/case-studies
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} ^(.+?)/*$
    RewriteCond %1.html !-f
    RewriteRule ^resources/. https://cstech.ai/case-studies [R=301,L,NC]
    # END cstech-301-safety-net

    # ---- 4. https and the main host (only for cstech.ai; safe behind a proxy) ------------
    RewriteCond %{HTTP_HOST} ^(www\.)?cstech\.ai$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https [NC]
    RewriteRule ^ https://cstech.ai%{REQUEST_URI} [R=301,L,NE]

    RewriteCond %{HTTP_HOST} ^www\.cstech\.ai$ [NC]
    RewriteRule ^ https://cstech.ai%{REQUEST_URI} [R=301,L,NE]

    # ---- 5. Clean URLs ------------------------------------------------------------------
    # /index.html, /home, /home.html -> /
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{THE_REQUEST} \s/+(index|home)(\.html)?[\s?] [NC]
    RewriteRule ^ / [R=301,L]

    # old filter form /case-studies.html/Industries/X -> /case-studies/Industries/X
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{THE_REQUEST} \s/+case-studies\.html/([^?\s]+) [NC]
    RewriteRule ^ /case-studies/%1 [R=301,L,NE]

    # /about.html -> /about   (real pages only; the includes/ fragments and the 404 page stay as files)
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
    RewriteCond %1 !^(includes/|404$)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ /%1 [R=301,L,NE]

    # /about/ -> /about   (a trailing slash on a page; PATH_INFO check = the URL is exactly that page)
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{PATH_INFO} ^/*$
    RewriteCond %{REQUEST_FILENAME} ^(.+?)/*$
    RewriteCond %1.html -f
    RewriteRule ^(.+?)/+$ /$1 [R=301,L]

    # ---- 6. Case-studies filter views are the listing page -----------------------------
    RewriteRule ^case-studies/(Geospatial|Mobility|Emerging-Tech|Industries|Services|GCC|USA)(/[^.]*)?$ case-studies.html [L,NC]

    # ---- 5b. Serve /about from about.html (never the 404 page itself; /about/extra stays a 404) --
    RewriteCond %{REQUEST_URI} !^/404/?$
    RewriteCond %{PATH_INFO} ^/*$
    RewriteCond %{REQUEST_FILENAME} ^(.+?)/*$
    RewriteCond %1.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]

    # ---- 7. Folders without a page (e.g. /img/, /services/) -> 404, never a listing ----
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.html !-f
    RewriteRule ^ - [R=404,L]

    # HTML fragments loaded by the pages' JavaScript: never indexed on their own
    RewriteRule ^includes/ - [E=CS_NOINDEX:1]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex" env=CS_NOINDEX
</IfModule>
